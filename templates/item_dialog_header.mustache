{{!
    @template local_nextpool/item_dialog_header
    Header shared between the preview fallback page and item dialog.
    Example context (json): {"typefull":"File","versionfull":"Version 1","canplace":false}
}}
<div class="local-nextpool-previewheader">
    {{> local_nextpool/item_summary }}
    {{#versionnotice}}<p class="alert alert-info">{{versionnotice}}</p>{{/versionnotice}}
    {{#canplace}}<p><a class="btn btn-primary" href="{{placeurl}}">{{#str}} placeincourse, local_nextpool {{/str}}</a></p>{{/canplace}}
    {{#placereason}}<p>{{placereason}}</p>{{/placereason}}
</div>
