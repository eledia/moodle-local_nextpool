{{!
    @template local_nextpool/feedback_section

    Section "Feedback" of a catalogue item (F08, task81): the live region for announcements and the content that
    the JavaScript module reloads after each action (fragment "feedback").

    Context variables required for this template: see local_nextpool/feedback_content, plus
    * itemid - int
    * courseid - int, 0 for the editorial view
    * contextid - int, context of the fragment
    * filter - string, version filter

    Example context (json):
    {
        "itemid": 1, "courseid": 0, "contextid": 1, "filter": "all",
        "actionurl": "#", "sesskey": "x", "subscribed": true, "subscribeicon": "", "subscribehelp": "You get notifications.",
        "versionoptions": [{"value": 0, "label": "Item in general", "selected": true}],
        "filteroptions": [{"value": "all", "label": "All comments", "selected": true}],
        "empty": true
    }
}}
<section id="local-nextpool-feedback" class="local-nextpool-feedback mt-4" aria-labelledby="local-nextpool-feedback-heading"
    data-region="local-nextpool-feedback" data-itemid="{{itemid}}" data-courseid="{{courseid}}"
    data-contextid="{{contextid}}" data-filter="{{filter}}">
    <div class="visually-hidden" role="status" aria-live="polite" data-region="local-nextpool-feedback-status"></div>
    <div data-region="local-nextpool-feedback-content">
        {{> local_nextpool/feedback_content }}
    </div>
</section>
{{#js}}
    require(['local_nextpool/feedback'], function(feedback) {
        feedback.init('local-nextpool-feedback');
    });
{{/js}}
