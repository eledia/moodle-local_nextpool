{{!
    @template local_nextpool/item_summary
    Shared preview header pills.
    Example context (json): {"typefull":"File","versionfull":"Version 1","licensefull":"All rights reserved"}
}}
<ul class="list-unstyled d-flex flex-wrap gap-2 mb-3" aria-label="{{#str}} itemsummary, local_nextpool {{/str}}">
    <li><span class="badge bg-light text-dark border">{{typefull}}</span></li>
    <li><span class="badge bg-light text-dark border">{{versionfull}}</span></li>
    <li><span class="badge bg-light text-dark border" title="{{updatemodefull}}">{{{updatemodeicon}}} {{updatemodeshort}}</span></li>
    <li><span class="badge bg-light text-dark border">{{#licensecopyright}}<span aria-hidden="true">© </span>{{/licensecopyright}}{{licensefull}}</span></li>
    {{#duration}}<li><span class="badge bg-light text-dark border">{{duration}}</span></li>{{/duration}}
    {{#placed}}<li><span class="badge bg-success">{{placedtext}}</span></li>{{/placed}}
</ul>
